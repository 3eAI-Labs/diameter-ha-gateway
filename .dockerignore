# Keep the build context lean. Do NOT exclude web/ sources (the frontend stage
# builds them). client/ is the released client module's source; the build takes
# that module from go.sum, like the public tree, which has no client/.
client/
.git/
.gitignore
.worktrees/
.claude/
*.log

# Stale prebuilt binary at repo root — never copy into the image.
/diameter-gateway

# Regenerated by the build stages.
web/node_modules/
web/dist/

# Not needed to compile or run.
docs/
tests/
specs/
